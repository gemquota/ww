# Optional manual fallback if you are not using cookies.txt.
# WW automatically reads __Secure-1PSID and __Secure-1PSIDTS from
# a Netscape-format cookies.txt in the project root.
# Environment/.env values take precedence over cookies.txt.
SECURE_1PSID=
SECURE_1PSIDTS=

# Optional TypeSafe Jev System One decision service (backend only).
# Leave TYPESAFE_API_KEY empty to disable Jev UI decisions.
TYPESAFE_API_KEY=
WW_JEV_MODEL=jev-latest
WW_JEV_TIMEOUT=8
WW_JEV_MIN_CONFIDENCE=0.75
WW_JEV_DELIBERATION_THRESHOLD=0.35

# Gemini System Two connection + response deadline (seconds).
WW_UI_SYSTEM2_TIMEOUT=75
